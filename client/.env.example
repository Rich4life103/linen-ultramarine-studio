# Frontend environment variables (Vite).
# Copy to `.env.local` for local overrides. On Vercel, set these in
# Project → Settings → Environment Variables.

# Origin of the deployed API (no trailing slash, no /api suffix).
# Leave UNSET for local development — Vite proxies /api to http://localhost:4000.
# VITE_API_URL=https://linen-ultramarine-api.onrender.com
