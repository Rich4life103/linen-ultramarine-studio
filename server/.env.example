# Backend environment variables (Express API).
# Copy to `.env` for local overrides. On Render these are set via render.yaml.

# Port the API listens on (Render injects its own).
PORT=4000

# Secret used to sign session JWTs — use a long random value in production.
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Persistent storage locations (default to server/data and server/uploads).
# On a host with a single mounted disk, point both at that mount:
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads

# Set to "none" to force cross-site cookies outside production.
# COOKIE_SAMESITE=lax
